{
  "version": 1,
  "sdk_version": "0.20.1",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://osshbsfuqawrljizeruq.supabase.co/auth/v1",
    "require_oauth_client_claim": true,
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "socportal",
      "version": "0.1.0",
      "title": "SocPortal"
    },
    "tools": [
      {
        "name": "get_my_contracts",
        "title": "Get my contracts",
        "description": "List the signed-in customer's contracts (software, hardware, ERP, devices). Optionally filter to those expiring within the next 60 days.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "all",
                "expiring_soon"
              ],
              "description": "'all' returns every contract; 'expiring_soon' returns contracts ending within 60 days."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_my_devices",
        "title": "Get my Azure AD devices",
        "description": "List the signed-in customer's Azure AD synced devices with OS, compliance and last sign-in.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "get_my_licenses",
        "title": "Get my Microsoft 365 licenses",
        "description": "List the signed-in customer's Microsoft 365 / Office / Windows / EMS licenses with total and consumed units.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "get_copilot_usage",
        "title": "Get Microsoft 365 Copilot usage",
        "description": "List the signed-in customer's Microsoft 365 Copilot usage per user (assigned license and last activity across Chat/Teams/Word/Excel/PowerPoint/Outlook).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "get_my_tickets",
        "title": "Get my support tickets",
        "description": "List the signed-in customer's support tickets. Optionally filter to open (non-resolved) tickets.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "all",
                "open"
              ],
              "description": "'all' returns every ticket; 'open' excludes resolved."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "create_ticket",
        "title": "Create support ticket",
        "description": "Create a new support ticket for the signed-in user's company. Runs under RLS, so the ticket is always attached to that company and to this user as creator.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "subject": {
              "type": "string",
              "minLength": 3,
              "maxLength": 200,
              "description": "Short subject line for the ticket."
            },
            "description": {
              "type": "string",
              "minLength": 5,
              "description": "Detailed description of the issue or request."
            },
            "department": {
              "type": "string",
              "enum": [
                "technical",
                "software",
                "erp",
                "hardware",
                "devices"
              ],
              "description": "Target department."
            },
            "priority": {
              "type": "string",
              "enum": [
                "low",
                "normal",
                "high",
                "urgent"
              ],
              "description": "Ticket priority. Defaults to 'normal'."
            }
          },
          "required": [
            "subject",
            "description",
            "department"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "add_ticket_message",
        "title": "Add reply to a ticket",
        "description": "Post a customer reply on one of the signed-in user's tickets. Accepts the ticket id (UUID) or the numeric ticket_number. RLS ensures the ticket belongs to the user's company. Internal/admin messages are not supported.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "ticket_id": {
              "type": "string",
              "format": "uuid",
              "description": "Ticket UUID."
            },
            "ticket_number": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "description": "Numeric ticket number as shown in the portal."
            },
            "body": {
              "type": "string",
              "minLength": 1,
              "maxLength": 10000,
              "description": "Message body."
            }
          },
          "required": [
            "body"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
