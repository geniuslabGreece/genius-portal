# ── Frontend → self-hosted backend (Supabase stack στο VM) ────────────────
# Το API domain που κάνει proxy στο Kong του self-hosted Supabase.
VITE_SUPABASE_URL="https://api.geniusnetsoc.gr"
# ANON_KEY από το /opt/stack/supabase/.env (self-hosted)
VITE_SUPABASE_PUBLISHABLE_KEY="<ANON_KEY του self-hosted>"
VITE_SUPABASE_PROJECT_ID="selfhosted"
VITE_MCP_OAUTH_ISSUER="https://api.geniusnetsoc.gr/auth/v1"

# ── Reverse proxy ────────────────────────────────────────────────────────
# Το frontend τρέχει ΜΟΝΟ πίσω από τον nginx proxy (χωρίς δημόσια θύρα).
PORT=127.0.0.1:8080

DOMAIN=geniusnetsoc.gr
API_DOMAIN=api.geniusnetsoc.gr
# Πού ακούει το Kong του self-hosted Supabase (host του VM)
SUPABASE_API_UPSTREAM=host.docker.internal:8000

LETSENCRYPT_EMAIL=admin@geniusnetsoc.gr
