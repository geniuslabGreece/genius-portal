# Προσωρινό config ΜΟΝΟ για την πρώτη έκδοση πιστοποιητικού.
# Σερβίρει μόνο το ACME challenge — το OAuth ΔΕΝ δουλεύει σε http, οπότε
# όλα τα υπόλοιπα αιτήματα απαντούν 503 μέχρι να ενεργοποιηθεί το HTTPS.
server {
    listen 80 default_server;
    server_name ${DOMAIN} www.${DOMAIN} ${API_DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
        try_files $uri =404;
    }

    location / {
        return 503 "HTTPS certificate is being issued. Try again shortly.\n";
    }
}
